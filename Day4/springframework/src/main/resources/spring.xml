<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">
    <bean id="vehicle" class="org.example.springFramework.Vehicle">
        <property name="model" value="4" />
    </bean>

<!--    <bean id="car" class="org.example.springFramework.Car">-->
<!--        <constructor-arg ref="vehicle"/>-->
<!--    </bean>-->

    <bean id="bike" class="org.example.springFramework.Bike">
    <property name="vehicle" ref="vehicle" />
    </bean>
</beans>